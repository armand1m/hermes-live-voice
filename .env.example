# Normal installs use `hermes-live setup`. This file is for containers and
# source development; Hermes Live does not auto-load project .env files.

# Hermes Agent API Server
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_AGENT_API_SERVER_KEY=
# Normally unset: Hermes Live follows the model selected in the Hermes profile.
# HERMES_MODEL=openai/gpt-5.4-mini
# Saved-chat turns wait for tools and the final answer (default: at least 120s).
# HERMES_LIVE_HERMES_CHAT_TIMEOUT_MS=120000

# Voice: local, gemini, openai, or mock
HERMES_LIVE_PROVIDER=local

# NVIDIA Speech NIM provider (ASR + TTS; see docs/riva-migration.md).
# HERMES_LIVE_PROVIDER=riva
# HERMES_LIVE_RIVA_ASR_URL=ws://127.0.0.1:19000/v1/realtime?intent=transcription
# HERMES_LIVE_RIVA_TTS_URL=ws://127.0.0.1:19001/v1/realtime?intent=synthesize
# HERMES_LIVE_RIVA_BRAIN_URL=http://127.0.0.1:30000/v1/chat/completions
# HERMES_LIVE_RIVA_BRAIN_MODEL=qwen3.8-27b
# HERMES_LIVE_RIVA_VOICE=Magpie-Multilingual.EN-US.Jason
# HERMES_LIVE_RIVA_MINT_API_KEY=private-service-mint-key-if-enabled
# HERMES_LIVE_RIVA_WS_KEEPALIVE_MS=25000
# HERMES_LIVE_RIVA_BRAIN_MAX_TOKENS=2048
# HERMES_LIVE_RIVA_BRAIN_REASONING_EFFORT=low
# HERMES_LIVE_RIVA_ECHO_GUARD=true
# HERMES_LIVE_RIVA_ASR_WORD_BOOST=Hermes,herdr,exodia,Mac mini
# HERMES_LIVE_RIVA_ASR_WORD_BOOST_SCORE=30
# HERMES_LIVE_RIVA_BRAIN_STREAMING=false
# HERMES_LIVE_RIVA_BRAIN_THINKING=true
# HERMES_LIVE_RIVA_BRAIN_PREWARM=true
# Local knowledge index (node:sqlite FTS5, Node >= 22.5) for fast recall;
# turn context adds strong matches to each Riva brain turn.
# HERMES_LIVE_KNOWLEDGE_INDEX=true
# HERMES_LIVE_KNOWLEDGE_TURN_CONTEXT=false
# After voice sessions with 4+ user turns, one quiet Hermes run reviews the
# transcript and updates memory/skills with Hermes' own tools.
# HERMES_LIVE_KNOWLEDGE_REFLECTION=false
# Record what the speech gate heard for endpointing tuning (docs/vad-tuning.md).
# HERMES_LIVE_VAD_RECORDING=false
# HERMES_LIVE_VAD_RECORDING_MAX_MB=500
# HERMES_LIVE_VAD_RECORDING_RETENTION_DAYS=7

# Hugging Face speech-to-speech (no voice API key)
HERMES_LIVE_LOCAL_URL=ws://127.0.0.1:8765/v1/realtime
HERMES_LIVE_LOCAL_VOICE=Aiden

# External-work monitoring (plan §B): durable observation of herdr agents on
# exodia (local herdr) and mac-mini (through mssh). Disabled by default.
# HERMES_LIVE_EXTERNAL_WORK_ENABLED=true
# Announce external-agent state changes as spoken notifications.
# HERMES_LIVE_PROGRESS_ANNOUNCEMENTS=true
# HERMES_LIVE_HERDR_EXECUTABLE=herdr
# HERMES_LIVE_MSSH_EXECUTABLE=mssh

# Hosted alternatives
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# Select HERMES_LIVE_PROVIDER=openai explicitly when using this key.
# OPENAI_REALTIME_MODEL=gpt-realtime-2
# OPENAI_REALTIME_TURN_DETECTION=server_vad
# OPENAI_REALTIME_INPUT_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_REALTIME_INPUT_TRANSCRIPTION_LANGUAGE=en

# Gateway
HERMES_LIVE_HOST=127.0.0.1
HERMES_LIVE_PORT=8788
# Required when HERMES_LIVE_HOST is reachable from another machine.
# HERMES_LIVE_AUTH_TOKEN=
# HERMES_LIVE_ALLOW_ORIGIN=https://your-ui.example

# Common task controls (defaults shown)
HERMES_LIVE_MAX_CONCURRENT_TASKS=3
HERMES_LIVE_MAX_QUEUED_TASKS=32
# Only enable when your Hermes environment can safely trust model-declared read-only work.
HERMES_LIVE_TRUST_DECLARED_READ_ONLY=false

# Voice memory bridge (defaults shown). The digest injects Hermes memory,
# recent chat titles, and the skills list into each voice session; the browser
# binds one durable per-user voice thread instead of a new chat per tab.
# HERMES_LIVE_HERMES_HOME=/home/youruser/.hermes
# HERMES_LIVE_CONTEXT_DIGEST=true
# HERMES_LIVE_VOICE_THREAD_TITLE=Hermes Live Voice
# HERMES_LIVE_RECALL_SESSION_TITLE=Hermes Live Voice Recall
# HERMES_LIVE_RECALL_TIMEOUT_MS=30000

# Speech detection (defaults shown). "smart" runs the bundled Silero VAD model
# in the gateway so only confirmed human speech interrupts the agent; "energy"
# forces the dependency-free fallback, "disabled" restores client-side VAD.
HERMES_LIVE_VAD=smart
# HERMES_LIVE_VAD_MODEL=/absolute/path/to/silero_vad.onnx
# HERMES_LIVE_VAD_START_PROBABILITY=0.5
# HERMES_LIVE_VAD_STOP_PROBABILITY=0.25
# HERMES_LIVE_VAD_START_SUSTAIN_MS=100
# HERMES_LIVE_VAD_STOP_SUSTAIN_MS=500
# HERMES_LIVE_VAD_ECHO_START_PROBABILITY=0.7
# HERMES_LIVE_VAD_ECHO_START_SUSTAIN_MS=200
# HERMES_LIVE_VAD_PREROLL_MS=250
# HERMES_LIVE_VAD_TAIL_MS=400
# Half-duplex turn policy: while assistant audio is still draining (plus the
# tail below), confirmed speech never starts a turn — mic echo of the agent's
# own voice cannot become a user turn. Barge in by speaking after the pause.
# HERMES_LIVE_HALF_DUPLEX=false
# HERMES_LIVE_TURN_TAIL_MS=1000
# Force a ready deferred answer at the first response gap past this age.
# HERMES_LIVE_DEFERRED_ANSWER_MAX_DELAY_MS=15000

# Run `hermes-live print-config` for every resolved default. Advanced settings
# are documented in docs/setup.md.
